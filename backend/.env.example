# ===========================================
# 灵山慧游 AI 数字人导览系统 — 环境变量配置
# 复制此文件为 .env 并修改配置
# ===========================================

# 系统配置
APP_NAME=灵山慧游
APP_VERSION=1.0.0
DEBUG=true

# 数据库配置 (SQLite 无需修改，切 MySQL 时改这里)
DATABASE_URL=sqlite:///./data/lingshan.db

# 大模型配置 (OpenAI 兼容 API)
# 支持：通义千问 / 智谱GLM / DeepSeek / OpenAI
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# Embedding 向量化配置
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ChromaDB 向量数据库持久化目录
CHROMA_PERSIST_DIR=./data/chroma

# 语音识别 / 合成配置（预留）
ASR_PROVIDER=whisper
TTS_PROVIDER=browser

# 高德地图 Web 服务 Key（周边搜索/路径规划/天气）
AMAP_KEY=your-amap-key-here

# Neo4j 知识图谱（GraphRAG）
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# JWT 签名密钥（生产环境务必修改为随机长字符串）
JWT_SECRET=change-me-in-production

# 讯飞交互数字人（apiSecret 仅存服务端，前端通过 /api/digital-human/xfyun-auth 获取临时签名 URL）
XFYUN_SERVER_URL=wss://avatar.cn-huadong-1.xf-yun.com/v1/interact
XFYUN_APP_ID=your-xfyun-app-id
XFYUN_API_KEY=your-xfyun-api-key
XFYUN_API_SECRET=your-xfyun-api-secret
XFYUN_SCENE_ID=your-xfyun-scene-id

# 图像生成（明信片 AI 绘图，留空则复用 Embedding 的 SiliconFlow 配置）
IMAGE_API_KEY=
IMAGE_BASE_URL=

# 生产部署
# 允许的跨域来源（逗号分隔），前后端同域部署时保持 * 或填域名均可
CORS_ORIGINS=*
# 数字人形象照上传目录，留空默认 <仓库根目录>/frontend/public/avatars
UPLOAD_DIR=

# 服务监听地址与端口（python -m app.main 启动时生效）
HOST=127.0.0.1
PORT=8000
