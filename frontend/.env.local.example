# ===========================================
# 灵境云游 前端 — 环境变量配置
# 复制此文件为 .env.local 并修改
#
# 说明：所有第三方 API 密钥（LLM / TTS / 绘图 / 讯飞数字人）
# 均已收归后端，前端只需配置后端地址。
# ===========================================

# 后端 API 地址（端口与后端 .env 的 PORT 对应）
NEXT_PUBLIC_API_URL=http://localhost:8000

# 注意：Next.js 不会从本文件读取端口！
# 改前端端口请用命令行参数，如 package.json 里 "dev": "next dev -p 3001"，
# 或在终端先设置环境变量再启动：
#   PowerShell:  $env:PORT=3001; pnpm dev
#   CMD/Linux:   set PORT=3001 && pnpm dev  /  PORT=3001 pnpm dev
